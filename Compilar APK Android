name: Compilar APK Android
on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  compilar:
    runs-on: ubuntu-latest
    steps:
      - name: 1. Descargar codigo
        uses: actions/checkout@v4

      - name: 2. Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: 3. Configurar Java JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: 17

      - name: 4. Preparar proyecto nativo Android
        run: |
          mkdir -p www
          cp index.html www/index.html
          npm install
          npx cap init "SumUp Ahorro" "com.sumup.ahorro" --web-dir www
          npx cap add android
          npx cap sync android

      - name: 5. Compilar archivo APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: 6. Publicar APK descargable
        uses: actions/upload-artifact@v4
        with:
          name: SumUp-Ahorro-App
          path: android/app/build/outputs/apk/debug/app-debug.apk
